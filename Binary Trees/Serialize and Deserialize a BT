string serialize(Node* root){

    if(!root)
        return "#,";

    string ans = to_string(root->data) + ",";

    ans += serialize(root->left);
    ans += serialize(root->right);

    return ans;
}


Node* solveDeserialize(stringstream& ss){

    string value;
    getline(ss, value, ',');

    if(value == "#")
        return NULL;

    Node* root = new Node(stoi(value));

    root->left = solveDeserialize(ss);
    root->right = solveDeserialize(ss);

    return root;
}


Node* deserialize(string data){

    stringstream ss(data);

    return solveDeserialize(ss);
}
