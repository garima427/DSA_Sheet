Node* solvePost(vector<int>& postorder, int& postIndex,
                int inStart, int inEnd,
                unordered_map<int,int>& inMap){

     if(inStart>inEnd)
                return NULL;
        
        int root = postorder[postIndex];
        postIndex--;
        int pos = inMap[root];
        Node* node = new Node(root);

       
        node->right = solvePost(postorder,postIndex, pos+1,inEnd ,inMap);
         node->left = solvePost(postorder,postIndex, inStart, pos-1,inMap);

        return node;
}
