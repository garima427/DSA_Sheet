bool childrenSum(Node* root){
    if(!root)
        return true;

    if(!root->left && !root->right)
        return true;
    
    int left = (root->left)?root->left->data:0;
    int right = (root->right)?root->right->data:0;

    return (root->data==right+left) && childrenSum(root->left) && childrenSum(root->right);
}
