void solve(Node* root,vector<int>& path,vector<vector<int>>& ans){
    if(root==NULL){
        return;
    }

    path.push_back(root->data);

    if(!root->left && !root->right){
        ans.push_back(path);
    }

    if(root->left)
        solve(root->left,path,ans);
    if(root->right)
        solve(root->right,path,ans);

    path.pop_back();
    
}
