Node* buildTree(vector<int>& preorder, vector<int>& inorder){
    unordered_map<int,int> inMap;
    for(int i=0; i<inorder.size(); i++){
        inMap[inorder[i]] = i;
    }
    solve(preorder,0,0,inorder.size()-1,inMap);
}

Node* solve(vector<int>& preorder, int& preIndex,
            int inStart, int inEnd,
            unordered_map<int,int>& inMap){

        if(inStart>inEnd)
                return NULL;
        
        int root = preorder[preIndex];
        preIndex++;
        int pos = inMap[root];
        Node* node = new Node(root);

        node->left = solve(preorder,preIndex, inStart, pos-1,inMap);
        node->right = solve(preorder,preIndex, pos+1,inEnd ,inMap);

        return node;
}
