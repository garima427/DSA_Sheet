 double myPow(double x, int n) {
    long long exp = n;

    if (exp < 0) {
        x = 1 / x;
        exp = -exp;
    }

    if (x == 0)
        return 0;

    if (exp == 0)
        return 1;

    if (exp == 1)
        return x;

    double half = myPow(x, exp / 2);

    if (exp % 2 == 0)
        return half * half;

    return x * half * half;
}
