void solve(int idx, int n, vector<int>& nums, vector<int> &curr, vector<vector<int>> &ans){
    if(idx==n){
        ans.push_back(curr);
        return;
    }
    //take
    curr.push_back(nums[idx]);
    solve(idx+1,n,nums,curr,ans);
    curr.pop_back();

    //don't take
    solve(idx+1,n,nums,curr,ans);
}
vector<vector<int>> subsets(vector<int>& nums){
    int n = nums.size();
    vector<vector<int>> ans;
    vector<int> curr;
    int idx = 0;
    solve(idx,n,nums,curr,ans);
    return ans;
}
