void solve(int idx,int sum, int target,vector<int>& candidates,vector<int>& curr,vector<vector<int>>& ans){
    if(sum==target){
        ans.push_back(curr);
        return;
    }
    if(idx==candidates.size()){
        return;
    }
    //take
    if(idx>0 && candidates[idx]!=candidates[idx-1]){
        curr.push_back(candidates[idx]);
        solve(idx+1,sum+candidates[idx],target,candidates,curr,ans);
        curr.pop_back();
    }

    //dont take
    solve(idx+1,sum,target,candidates,curr,ans);
}
           
vector<vector<int>> combinationSum2(vector<int>& candidates, int target){
    vector<vector<int>> ans;
    vector<int> curr;
    sort(candidates.begin(),candidates.end());
    solve(0,target,candidates,curr,ans);
    return ans;
}
