int helper(int idx, int sum, vector<int>& nums, int K){
    if(sum == K)
        return 1;

    if(idx == nums.size())
        return 0;

    
    int take = helper(idx+1,sum+nums[idx],nums,K);
    int notTake = helper(idx+1,sum,nums,K);

    return take+notTake;
}

int countSubsequenceSum(vector<int>& nums, int K){
    return helper(0,0,nums,K);
}
