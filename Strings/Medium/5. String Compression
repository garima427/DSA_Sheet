int compress(vector<char>& chars) {
    int n = chars.size();
    int write = 0, r = 0;

    while (r < n) {
        char curr = chars[r];
        int start = r;

        while (r < n && chars[r] == curr) {
            r++;
        }

        int count = r - start;
        chars[write++] = curr;

        if (count > 1) {
            string s = to_string(count);
            for (char digit : s) {
                chars[write++] = digit;
            }
        }
    }

    return write;
}
