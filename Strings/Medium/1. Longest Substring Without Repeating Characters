int lengthOfLongestSubstring(string s){
    int l = 0, r = 0;
    int maxLen = 0;
    unordered_map<char,int> mpp;
    while(r<s.size()){
        while(mpp[s[r]]>=1){
            mpp[s[l]]--;
            l++;
        }
        maxLen = max(maxLen,r-l+1);
        mpp[s[r]]++;
        r++;
    }
    return maxLen;
}
