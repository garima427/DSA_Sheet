class StackImplementation {
private:
    int topIndex;
    int st[10];

public:
    StackImplementation() {
        topIndex = -1;
    }

    void push(int x) {
        if (topIndex >= 9)
            return; // Stack overflow

        topIndex++;
        st[topIndex] = x;
    }

    void pop() {
        if (topIndex == -1)
            return; // Stack underflow

        topIndex--;
    }

    int getTop() {
        if (topIndex == -1)
            return -1;

        return st[topIndex];
    }

    int size() {
        return topIndex + 1;
    }
};
```

## 2. Queue

Your circular queue logic is almost right, but there are **three issues**:

* You need `public:`
* `int q[size];` is not valid standard C++ when `size` is a normal member variable
* You're not checking whether the queue is **full**
* In `pop()`, when `currsize == 1`, you need to decrement `currsize`

```cpp
class QueueImplementation {
private:
    static const int capacity = 10;

    int q[capacity];
    int start;
    int end;
    int currsize;

public:
    QueueImplementation() {
        start = -1;
        end = -1;
        currsize = 0;
    }

    void push(int x) {
        // Queue full
        if (currsize == capacity)
            return;

        // First element
        if (currsize == 0) {
            start = end = 0;
        }
        else {
            end = (end + 1) % capacity;
        }

        q[end] = x;
        currsize++;
    }

    void pop() {
        if (currsize == 0)
            return;

        if (currsize == 1) {
            start = end = -1;
            currsize = 0;
            return;
        }

        start = (start + 1) % capacity;
        currsize--;
    }

    int front() {
        if (currsize == 0)
            return -1;

        return q[start];
    }

    int size() {
        return currsize;
    }
};
```
