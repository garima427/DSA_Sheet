class Queue{
    Queue(){
        stack<int> st1,st2;
    }
    void push(int x){
        while(st1.size()){
            st2.push(st1.top());
            st1.pop();
        }
        st1.push(x);
        while(st2.size()){
            st1.push(st2.top());
            st2.pop();
        }
    }
    void pop(){
        st1.pop();
    }
    int front(){
        return st1.top();
    }
};

class Stack{
    Stack(){
        queue<int> q;
        void push(int x){
            s = q.size();
            q.push(x);
            for(int i=0;i<s;i++){
                q.push(q.front())
                q.pop();
            }
        }
        void pop(){
            q.pop();
        }
        int top(){
            return q.front();
        }
    }
};
