stack<char> st;

for (char ch : s) {

    if (ch == '(' || ch == '{' || ch == '[') {
        st.push(ch);
    }

    else {

        // No opening bracket available
        if (st.empty())
            return false;

        if ((ch == ')' && st.top() != '(') ||
            (ch == ']' && st.top() != '[') ||
            (ch == '}' && st.top() != '{')) {
            return false;
        }

        // Matching opening bracket found
        st.pop();
    }
}

return st.empty();
