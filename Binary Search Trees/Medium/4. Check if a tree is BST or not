bool check(Node* root,int leftBound,int rightBound){
    if(!root)
        return true;

    if(root->data<=leftBound || root->data>=rightBound)
        return false;
    
    return check(root->left,leftBound,root->data) && check(root->right,root->data,rightBound);
    
}
bool isBST(Node* root){
    int leftBound = INT_MIN;
    int rightBound = INT_MAX;
    return check(root,leftBound,rightBound);
}
