void inorder(Node* root, int &k, int &ans){
    if(!root || k==0)
        return;
        
    inorder(root->left,k,ans);
    k--;
    if(k==0)
        ans = root->data;
    inorder(root->right,k,ans);
}
int kthSmallest(Node* root, int &k){
    if(!root || k==0)
        return -1;

    int ans = INT_MAX;
    inorder(root,k,ans);
    return ans;
}
int kthLargest(Node* root, int k){
    if(!root || k==0)
        return -1;

    int ans = INT_MAX;
    inorder(root,k,ans);
    return ans;
}

void inorder(Node* root, int &k, int &ans){
    if(!root || k==0)
        return;
        
    inorder(root->right,k,ans);
    k--;
    if(k==0)
        ans = root->data;
    inorder(root->left,k,ans);
}
